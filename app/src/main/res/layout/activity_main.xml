<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Home screen: blank canvas over wallpaper. Swipe up OR tap the handle below opens the drawer. -->
    <FrameLayout
        android:id="@+id/homeRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Always-visible drawer handle: swipe gestures don't register reliably on emulators/mouse input,
         so this button guarantees the app drawer is always reachable with a plain tap. -->
    <TextView
        android:id="@+id/openDrawerHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:paddingHorizontal="28dp"
        android:paddingVertical="10dp"
        android:background="@drawable/search_bar_bg"
        android:text="Apps"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

    <!-- App drawer overlay, hidden by default -->
    <LinearLayout
        android:id="@+id/appDrawerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#E6101010"
        android:visibility="gone"
        android:paddingTop="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search apps"
                android:textColorHint="#AAAAAA"
                android:textColor="#FFFFFF"
                android:background="@drawable/search_bar_bg"
                android:padding="12dp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

            <TextView
                android:id="@+id/drawerMenuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:padding="12dp"
                android:text="⋮"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appDrawerRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

    </LinearLayout>

</FrameLayout>
